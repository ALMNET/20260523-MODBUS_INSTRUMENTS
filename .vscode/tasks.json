{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build STM32",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "Debug", "-j8"],
            "group": { "kind": "build", "isDefault": true },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean STM32",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "Debug", "--target", "clean"],
            "options": { "cwd": "${workspaceFolder}" }
        }
    ]
}